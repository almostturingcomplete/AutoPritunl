# AutoPritunl configuration. Copy to .env (chmod 600). Never commit .env.
# Per-host overrides go in .env.local (same format, wins over .env).

# --- Google account used for Pritunl SSO -------------------------------------
GMAIL=you@example.com
GPASS=
# base32 TOTP secret from Google 2-Step Verification > Authenticator (QR or "Can't scan it?").
# Inactive until you confirm enrollment with a code: `glogin --totp`. See README "Secrets".
GTOTP=
# optional comma-separated backup codes
GBACKUP=

# --- Pritunl profile -----------------------------------------------------------
# Exported profile from the Pritunl user portal (.zip, .tar or .ovpn). Preferred.
PRITUNL_PROFILE_FILE=~/.cache/glogin/profile.zip
# Or a pritunl://host/ku/... link (these expire after a while).
PRITUNL_PROFILE=

# --- What the VPN pushes (read from a connected client, see README) -----------
# space separated CIDRs; used by gateway mode (sshuttle) and WireGuard device configs
VPN_ROUTES=10.0.0.0/24 10.0.1.0/24 192.0.2.10/32
# resolver and search domain pushed by the VPN (pritunl-client logs: dhcp-option DNS / DOMAIN)
VPN_DNS=10.0.0.2
VPN_DOMAIN=example.internal
# tunnel interface name on the Linux gateway (pritunl-client uses tun0)
VPN_TUN=tun0

# --- Gateway (optional): a Linux host that holds the VPN for everyone ----------
# ssh alias from ~/.ssh/config; key must be passphrase-less so the keepalive can use it
GATEWAY_HOST=
# where the repo lives on the gateway (relative to $HOME)
GATEWAY_INSTALL_DIR=AutoPritunl
# auto | local | gateway  (install.sh sets local in .env.local on Linux hosts)
PVPN_MODE=auto
PVPN_INTERVAL=30
# launchd label on macOS
SERVICE_LABEL=com.autopritunl.keepalive

# --- WireGuard hub on the gateway (optional, for phones) -----------------------
WG_NET=10.9.0
WG_NET6=fd09::
WG_PORT=51820
# printed by wireguard/hub/setup-hub.sh
WG_ENDPOINT=vpn.example.com:51820
WG_SERVER_PUBKEY=
